{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sessions.schema.json",
  "title": "Saki v1 capability-gated complete display set",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "id",
        "session",
        "seq",
        "sessions",
        "total",
        "hidden_attention",
        "capacity_rejected"
      ],
      "properties": {
        "type": {
          "const": "sessions"
        },
        "sessions": {
          "type": "array",
          "maxItems": 4,
          "description": "Complete ordered projection: latest accepted user submission first; remaining items ordered by attention priority. Empty clears the display.",
          "items": {
            "type": "object",
            "required": [
              "source",
              "run_id",
              "revision",
              "fresh",
              "state",
              "task"
            ],
            "properties": {
              "state": {
                "enum": [
                  "idle",
                  "starting",
                  "thinking",
                  "working",
                  "waiting_user",
                  "waiting_approval",
                  "completed",
                  "failed",
                  "cancelled"
                ]
              },
              "task": {
                "type": "object",
                "required": [
                  "id",
                  "title"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "additionalProperties": true
              },
              "activity": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "plan",
                      "read",
                      "edit",
                      "shell",
                      "web",
                      "test",
                      "message",
                      "other"
                    ]
                  },
                  "summary": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "detail": {
                    "type": "string",
                    "maxLength": 512
                  }
                },
                "additionalProperties": true
              },
              "progress": {
                "type": "object",
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "none",
                      "indeterminate",
                      "determinate"
                    ]
                  },
                  "percent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 64
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "mode": {
                          "const": "determinate"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "percent"
                      ]
                    }
                  }
                ],
                "additionalProperties": true
              },
              "elapsed_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "agent": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "model": {
                    "type": "string",
                    "maxLength": 64
                  }
                },
                "additionalProperties": true
              },
              "source": {
                "enum": [
                  "codex",
                  "claude_code",
                  "legacy"
                ]
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "fresh": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "source": {
                      "enum": [
                        "codex",
                        "claude_code"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "task": {
                      "properties": {
                        "id": {
                          "pattern": "^[a-f0-9]{32}$"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "hidden_attention": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "capacity_rejected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    }
  ]
}
