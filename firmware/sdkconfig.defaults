# Saki options shared by dev and release profiles. Board-critical settings are
# kept separately in config/sdkconfig.vendor.
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Saki"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Saki Agent Display"
CONFIG_TINYUSB_DESC_SERIAL_STRING="saki"
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512
CONFIG_TINYUSB_CDC_EP_BUFSIZE=512
CONFIG_LV_MEM_SIZE_KILOBYTES=48
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_USE_FONT_COMPRESSED=y

# app_main initializes the display, protocol and USB stacks before it exits.
# Keep at least 1 KiB of measured headroom on the target device.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120
