# Release profile: optimize for size and retain only warning/error diagnostics.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
CONFIG_TINYUSB_DEBUG_LEVEL=0
# CONFIG_SAKI_UI_DEMO is not set
CONFIG_SAKI_BACKLIGHT_ACTIVE_PERCENT=80
CONFIG_SAKI_BACKLIGHT_IDLE_PERCENT=35
CONFIG_SAKI_BACKLIGHT_DISCONNECTED_PERCENT=20
CONFIG_SAKI_BACKLIGHT_IDLE_TIMEOUT_SECONDS=300
CONFIG_SAKI_BACKLIGHT_DISCONNECTED_TIMEOUT_SECONDS=60
# CONFIG_UNITY_ENABLE_IDF_TEST_RUNNER is not set

# Unused upstream demos must not enter a release image.
# CONFIG_LV_USE_DEMO_WIDGETS is not set
# CONFIG_LV_USE_DEMO_KEYPAD_AND_ENCODER is not set
# CONFIG_LV_USE_DEMO_BENCHMARK is not set
# CONFIG_LV_DEMO_BENCHMARK_RGB565A8 is not set
# CONFIG_LV_USE_DEMO_STRESS is not set
# CONFIG_LV_USE_DEMO_MUSIC is not set
